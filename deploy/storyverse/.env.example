# Stack storyverse (Marco 2). Copie para /home/deploy/storyverse/.env na VPS e
# defina uma senha forte. NUNCA versione o .env.

POSTGRES_DB=storyverse
POSTGRES_USER=storyverse
POSTGRES_PASSWORD=
API_DB_PASSWORD=
# Tag imutável publicada pela CI (SHA do commit) ou digest.
API_IMAGE=

