# Stack storyverse (Marco 2). Copie para /home/deploy/storyverse/.env na VPS e
# defina uma senha forte. NUNCA versione o .env.

POSTGRES_DB=storyverse
POSTGRES_USER=storyverse
POSTGRES_PASSWORD=
API_DB_PASSWORD=
# Tag imutável publicada pela CI (SHA do commit) ou digest.
API_IMAGE=

# IA (chaves no servidor). Sem nenhuma, o chat fica em modo demonstração.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Cota de IA no servidor. AI_DAILY_GLOBAL_LIMIT=0 desliga o modo economia.
AI_DAILY_MESSAGE_LIMIT=50
AI_DAILY_GLOBAL_LIMIT=0
AI_PER_MINUTE_LIMIT=6

# Sentry (opcional; sem DSN o SDK fica desligado).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Endereço público usado nos links de confirmação e recuperação de senha.
APP_PUBLIC_URL=https://storyverse.2.29.42.104.sslip.io
APP_PUBLIC_API_URL=https://api.storyverse.2.29.42.104.sslip.io
# APP_COMMUNITY_COVER_HOSTS=covers.openlibrary.org,openlibrary.org,www.openlibrary.org,archive.org,www.archive.org
# true: o cadastro só entra depois de confirmar o e-mail (recomendado em produção).
APP_AUTH_REQUIRE_EMAIL_CONFIRMATION=true
# APP_AUTH_CONFIRMATION_TTL=PT24H
# APP_AUTH_RESET_TTL=PT1H
# Refresh token em cookie HttpOnly. Em produção (web/API no mesmo site): Secure=true, SameSite=Lax.
APP_AUTH_REFRESH_COOKIE_SECURE=true
APP_AUTH_REFRESH_COOKIE_SAME_SITE=Lax
APP_RATE_LIMIT_PERSISTENT=true
# DB_POOL_SIZE=20

# SMTP dos e-mails de confirmação e recuperação. Sem estas variáveis, cadastro e
# recuperação de senha ficam indisponíveis (a API responde 503).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@seudominio.com
SMTP_FROM_NAME=Storyverse
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false

# Backup diario (deploy/backup.sh). Sem STORYVERSE_BACKUP_REMOTE a copia fica so na VPS.
# STORYVERSE_BACKUP_REMOTE=usuario@host:/caminho/storyverse
# STORYVERSE_BACKUP_RETENTION_DAYS=14
