# Template do .env da VPS para o Marco 3 (corte).
# Copie para /home/deploy/storyverse/.env, preencha os valores e proteja:
#   chmod 600 /home/deploy/storyverse/.env
# NUNCA versione este arquivo. Os valores reais ficam fora do repositório
# (ex.: ~/Documents/storyverse/credenciais-marco3.env).

# --- Banco (papel administrativo, usado só pelo Flyway para migrations) ---
POSTGRES_DB=storyverse
POSTGRES_USER=storyverse
POSTGRES_PASSWORD=

# --- Credencial de runtime da API (sem superuser/bypass/DDL) ---
# Mesma senha definida com: psql -c '\password storyverse_api'
API_DB_PASSWORD=

# --- Imagem publicada pela CI, por SHA/digest (nunca :latest) ---
API_IMAGE=ghcr.io/axyonsoftwarehouse/story-verse-api:sha-<commit>

# --- CORS / site ---
APP_CORS_ALLOWED_ORIGINS=https://storyverse.2.29.42.104.sslip.io

# --- IA no servidor (NUNCA prefixo VITE_) ---
# Sem chave, o chat fica em modo demonstração.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
