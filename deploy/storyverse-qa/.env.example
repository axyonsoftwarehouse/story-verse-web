# .env da stack de QA (/home/deploy/storyverse-qa/.env, chmod 600). Nunca commitar o .env real.
# Gere cada senha na própria VPS: openssl rand -base64 24

POSTGRES_DB=storyverse_qa
POSTGRES_USER=storyverse_qa
POSTGRES_PASSWORD=
API_DB_PASSWORD=
# Imagem da API (o deploy de QA troca para ghcr.io/axyonsoftwarehouse/story-verse-api:qa-<sha>).
API_IMAGE=ghcr.io/axyonsoftwarehouse/story-verse-api:main
# Senha das contas de teste (qa-leitor, qa-sem-estante, qa-admin @example.com).
QA_TEST_PASSWORD=
# Opcional: mesmo DSN da produção; os eventos chegam com environment=qa.
SENTRY_DSN=
SENTRY_RELEASE=

# Cloudflare R2 (bucket privado catalog-audio). O mesmo token da produção serve;
# se preferir isolar, crie um token limitado ao bucket e use-o só aqui.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=catalog-audio
R2_REGION=auto
