# ── Foodie (staging) — mesmas rotas do Caddyfile atual ──────────────
staging.2.29.42.104.sslip.io,
cliente.2.29.42.104.sslip.io,
restaurante.2.29.42.104.sslip.io,
entregador.2.29.42.104.sslip.io,
admin.2.29.42.104.sslip.io {
    encode zstd gzip
    reverse_proxy foodie-staging-web-1:3001
}

api.staging.2.29.42.104.sslip.io {
    encode zstd gzip
    reverse_proxy foodie-staging-api-1:4001
}

# ── Storyverse — API (backend) ──────────────────────────────────────
api.storyverse.2.29.42.104.sslip.io {
    encode zstd gzip
    request_body {
        max_size 51MB
    }
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000"
    }
    reverse_proxy storyverse-api-1:8080
}

# ── Storyverse (novo) ───────────────────────────────────────────────
storyverse.2.29.42.104.sslip.io {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000"
        Cross-Origin-Opener-Policy "same-origin"
        Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
        # Scripts de CDN só nas pastas versionadas que o app usa (onnxruntime e piper), não o CDN
        # inteiro: qualquer pacote npm do jsDelivr/cdnjs passaria pela CSP.
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdnjs.cloudflare.com/ajax/libs/onnxruntime-web/1.18.0/ https://cdn.jsdelivr.net/npm/@diffusionstudio/piper-wasm@1.0.0/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: data: https://*.r2.cloudflarestorage.com; worker-src 'self' blob: https://cdnjs.cloudflare.com/ajax/libs/onnxruntime-web/1.18.0/ https://cdn.jsdelivr.net/npm/@diffusionstudio/piper-wasm@1.0.0/; connect-src 'self' data: https://*.r2.cloudflarestorage.com https://api.storyverse.2.29.42.104.sslip.io https://fonts.googleapis.com https://fonts.gstatic.com https://huggingface.co https://*.huggingface.co https://*.hf.co https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://*.sentry.io https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://translate.googleapis.com https://api.mymemory.translated.net https://openlibrary.org https://*.openlibrary.org https://gutenberg.org https://*.gutenberg.org https://aleph.pglaf.org https://image.pollinations.ai https://*.wikipedia.org https://*.wikimedia.org https://*.wiktionary.org; manifest-src 'self'; upgrade-insecure-requests"
    }

    # proxies públicos (mesmos destinos do vite.config.ts, que faz o papel em dev)
    # Gutenberg: só a busca, o texto e a capa que o app pede. O proxy aberto servia qualquer
    # caminho como 'self' e transformava a VPS num proxy público do gutenberg.org.
    handle /gutenberg-search {
        rewrite * /ebooks/search.opds/
        reverse_proxy https://www.gutenberg.org
    }
    @gutenberg-text path_regexp gutenbergText ^/gutenberg/cache/epub/[0-9]+/pg[0-9]+\.txt$
    handle @gutenberg-text {
        uri strip_prefix /gutenberg
        reverse_proxy https://www.gutenberg.org {
            header_down Content-Type "text/plain; charset=utf-8"
        }
    }
    @gutenberg-cover path_regexp gutenbergCover ^/gutenberg/cache/epub/[0-9]+/pg[0-9]+\.cover\.medium\.jpg$
    handle @gutenberg-cover {
        uri strip_prefix /gutenberg
        reverse_proxy https://www.gutenberg.org {
            header_down Content-Type "image/jpeg"
        }
    }
    @gutenberg-mirror-text path_regexp gutenbergMirrorText ^/gutenberg-mirror/cache/epub/[0-9]+/pg[0-9]+\.txt$
    handle @gutenberg-mirror-text {
        uri strip_prefix /gutenberg-mirror
        reverse_proxy https://aleph.pglaf.org {
            header_down Content-Type "text/plain; charset=utf-8"
        }
    }
    @gutenberg-mirror-cover path_regexp gutenbergMirrorCover ^/gutenberg-mirror/cache/epub/[0-9]+/pg[0-9]+\.cover\.medium\.jpg$
    handle @gutenberg-mirror-cover {
        uri strip_prefix /gutenberg-mirror
        reverse_proxy https://aleph.pglaf.org {
            header_down Content-Type "image/jpeg"
        }
    }
    # Fora dessa lista, 404 em vez de cair no SPA (que responderia 200 com HTML).
    handle /gutenberg/* {
        respond 404
    }
    handle /gutenberg-mirror/* {
        respond 404
    }
    # Open Library: só a busca, a ficha da obra (resumo no catálogo) e as capas que o app usa.
    # O proxy aberto servia qualquer caminho como 'self', e a API deles aceita JSONP (?callback=) — um <script src="/openlibrary/…">
    # passaria pela CSP. Sem callback, e sempre como JSON (com nosniff, o navegador não executa).
    handle /openlibrary/search.json {
        uri strip_prefix /openlibrary
        uri query -callback
        reverse_proxy https://openlibrary.org {
            header_down Content-Type "application/json; charset=utf-8"
        }
    }
    handle /openlibrary/works/* {
        uri strip_prefix /openlibrary
        uri query -callback
        reverse_proxy https://openlibrary.org {
            header_down Content-Type "application/json; charset=utf-8"
        }
    }
    handle /ol-covers/b/* {
        uri strip_prefix /ol-covers
        reverse_proxy https://covers.openlibrary.org
    }

    # Umami pela mesma origem: só o script e o envio de visitas (a CSP continua self).
    handle /u/script.js {
        uri strip_prefix /u
        reverse_proxy umami-umami-1:3000
    }
    handle /u/api/send {
        uri strip_prefix /u
        reverse_proxy umami-umami-1:3000
    }

    # site (arquivos estáticos) com fallback das telas internas (SPA)
    handle {
        root * /srv/storyverse/current
        try_files {path} /index.html
        file_server
    }
}

# ── Storyverse QA — API (dados de teste; ver docs/QA.md) ───────────
api.qa.storyverse.2.29.42.104.sslip.io {
    encode zstd gzip
    request_body {
        max_size 51MB
    }
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000"
        X-Robots-Tag "noindex, nofollow"
    }
    reverse_proxy storyverse-qa-api-1:8080
}

