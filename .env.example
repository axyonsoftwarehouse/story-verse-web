# API própria na VPS. Obrigatória para login, sincronização, comunidade, ranking e IA.
VITE_API_URL=https://api.storyverse.2.29.42.104.sslip.io

# Opcional: "false" deixa ler e conversar sem conta (a conta fica opcional). Padrão: obrigatório.
# VITE_LOGIN_REQUIRED=false

# As chaves de IA ficam somente no servidor. Veja deploy/storyverse/.env.example.
# Nunca use variáveis VITE_* para segredos de IA, SMTP ou banco.

# Opcional: links do app nas lojas oficiais. Sem eles, o botão "Baixar app" instala o próprio
# site como app (PWA), com o passo a passo de cada aparelho.
# VITE_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=...
# VITE_IOS_APP_URL=https://apps.apple.com/app/...
